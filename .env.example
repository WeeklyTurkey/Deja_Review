# Copy to .env and fill in. Never commit real secrets.
# Review LLM: Muse via the Meta Model API.
LLM_MODEL=meta/muse-spark-1.3
META_API_KEY=
# Alternative: Gemini via Google AI Studio.
# LLM_MODEL=gemini/gemini-3.8-flash
# GEMINI_API_KEY=
# Reasoning effort for Muse reviews: minimal/low/medium/high/xhigh/max.
REASONING_EFFORT=minimal
HINDSIGHT_API_URL=http://localhost:8888
